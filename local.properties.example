# Copy to local.properties and fill in. local.properties is gitignored.
# NDK path is no longer set here -- app/build.gradle.kts pins
# android.ndkVersion = "27.0.12077973" and AGP resolves it automatically
# from sdk.dir/ndk/27.0.12077973 as long as that NDK is installed.

sdk.dir=/Users/YOU/Library/Android/sdk

smb.host=192.168.1.x
smb.user=your_username
smb.password=your_password
smb.share=music
# Path to a test M4A relative to the share root, e.g. Test/sample.m4a
smb.testfile=Test/sample.m4a
